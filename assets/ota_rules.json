[
  {
    "id": "updated-zh-date-time",
    "pattern": "^Updated\\s+((?:\\d{4}年\\s*)?\\d{1,2}月\\s*\\d{1,2}日)(?:[,，]\\s*|\\s+)((?:(?:凌晨|上午|中午|下午|晚上)\\s*)?\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\s*(?:AM|PM))?)$",
    "flags": "i",
    "replace": "更新于 $1 $2",
    "requireAscii": false
  },
  {
    "id": "updated-zh-date-only",
    "pattern": "^Updated\\s+((?:\\d{4}年\\s*)?\\d{1,2}月\\s*\\d{1,2}日)$",
    "flags": "i",
    "replace": "更新于 $1",
    "requireAscii": false
  },
  {
    "id": "updated-zh-clock",
    "pattern": "^Updated\\s+((?:凌晨|上午|中午|下午|晚上)\\s*\\d{1,2}:\\d{2}(?::\\d{2})?)$",
    "flags": "i",
    "replace": "更新于 $1",
    "requireAscii": false
  },
  {
    "id": "updated-num-date-time",
    "pattern": "^Updated\\s+(\\d{4}[-/]\\d{1,2}[-/]\\d{1,2}|\\d{1,2}/\\d{1,2}(?:/\\d{2,4})?)(?:[,，]\\s*|\\s+)((?:(?:凌晨|上午|中午|下午|晚上)\\s*)?\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\s*(?:AM|PM))?)$",
    "flags": "i",
    "replace": "更新于 $1 $2",
    "requireAscii": false
  }
]
