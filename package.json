{
  "name": "antigravity-zh-cn",
  "version": "0.6.0",
  "description": "Antigravity 桌面客户端全界面简体中文汉化补丁与跟版维护工程",
  "license": "MIT",
  "homepage": "https://github.com/downey37/antigravity-zh-cn#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/downey37/antigravity-zh-cn.git"
  },
  "keywords": [
    "antigravity",
    "i18n",
    "zh-cn",
    "chinese",
    "localization",
    "electron"
  ],
  "scripts": {
    "build": "node scripts/build_clean_engine.js",
    "build:ota": "node scripts/build_ota_pack.js",
    "build:portable": "node scripts/build_portable_release.js",
    "deploy": "powershell -ExecutionPolicy Bypass -File build_and_deploy.ps1",
    "restore": "node scripts/restore_antigravity.js",
    "verify": "node scripts/verify_engine.js",
    "verify:local": "node scripts/verify_engine.js --local",
    "scan": "node scripts/scan_updates.js --refresh",
    "version:check": "node scripts/release_version.js --check",
    "version:bump": "node scripts/release_version.js"
  },
  "dependencies": {
    "@electron/asar": "^4.3.0"
  }
}
